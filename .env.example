# Salin file ini menjadi .env.local lalu isi semua nilainya.
# Panduan lengkap cara mendapatkan tiap nilai ada di SETUP.md.

# Dari Google Cloud Console > Credentials (OAuth Client ID tipe "Desktop app")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hasil dari: node scripts/get-refresh-token.mjs
GOOGLE_REFRESH_TOKEN=

# ID spreadsheet Google Sheets (dari URL spreadsheet)
SHEET_ID=

# ID folder Google Drive tempat menyimpan foto (dari URL folder)
DRIVE_FOLDER_ID=

# Password untuk membuka album (bagikan hanya ke keluarga)
APP_PASSWORD=

# String acak untuk menandatangani cookie login (bebas, minimal 32 karakter)
AUTH_SECRET=

# Opsional: paksa data contoh untuk presentasi tanpa menghubungkan Google.
# Di lokal, credential Google kosong otomatis membuka demo. Di production,
# mode demo harus diaktifkan secara eksplisit dengan nilai true.
DEMO_MODE=false

# --- Bot Telegram (opsional) ---
# Kosongkan semuanya jika belum ingin memakai bot.

# Token dari @BotFather setelah membuat bot
TELEGRAM_BOT_TOKEN=

# String acak buatan sendiri; Telegram mengirim balik nilai ini di setiap
# webhook sehingga endpoint tahu permintaan benar-benar datang dari Telegram.
TELEGRAM_WEBHOOK_SECRET=

# ID chat yang boleh menyimpan momen, dipisah koma. Kirim pesan ke bot dan
# bot akan membalas dengan ID chat kamu.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Kiriman dari iPhone lewat Shortcuts (opsional) ---
# Token bebas buatan sendiri, dipakai Shortcut untuk mengirim foto. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Kosongkan kalau belum memakai fitur ini.
INGEST_TOKEN=
